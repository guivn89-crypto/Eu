LOCALFX.ready = true
LOCALFX_ACTIONS.Aura(true)
LOCALFX_ACTIONS["Círculo de salto"](true)
assert(fx.aura.Enabled and LOCALFX.circle)
Actions.setLocalFxIntensity("aura", 75)
assert(fx.aura.Brightness == 3)
callbacks[hum.StateChanged](nil, Enum.HumanoidStateType.Jumping)
callbacks[RunService.Heartbeat]()
assert(math.abs(fx.circle.Transparency - 0.45) < 0.00001 and fx.circle.Shape == Enum.PartType.Cylinder)
clock = 2; callbacks[RunService.Heartbeat](); assert(fx.circle.Transparency == 1)
applyLocalFxAll(false)
assert(not fx.aura.Enabled and LOCALFX.aura and LOCALFX.circle) -- preserva seleção
callbacks[hum.StateChanged](nil, Enum.HumanoidStateType.Jumping)
callbacks[RunService.Heartbeat](); assert(fx.circle.Transparency == 1)
applyLocalFxAll(true)
assert(fx.aura.Enabled and LOCALFX.circle)
callbacks[hum.StateChanged](nil, Enum.HumanoidStateType.Jumping)
callbacks[RunService.Heartbeat](); assert(math.abs(fx.circle.Transparency - 0.45) < 0.00001)
print("local FX integration OK")
