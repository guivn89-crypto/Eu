WORLD.master = true
WORLD.luz, WORLD.sol, WORLD.render, WORLD.neblina = true, true, true, true
WORLD.nuvens, WORLD.florescer, WORLD.desfoque, WORLD.cor, WORLD.profundidade, WORLD.raios = true, true, true, true, true, true
Actions.setAdjustment("brightness", 7)
Actions.setAdjustment("clockTime", 18)
Actions.setAdjustment("shadowSoftness", 0.3)
Actions.setAdjustment("fogDensity", 0.9)
Actions.setAdjustment("cloudCover", 0.8)
Actions.setAdjustment("bloom", 2)
Actions.setAdjustment("blur", 30)
Actions.setAdjustment("saturation", -0.5)
Actions.setAdjustment("contrast", 0.3)
Actions.setAdjustment("focus", 150)
Actions.setAdjustment("farIntensity", 0.7)
Actions.setAdjustment("rays", 0.8)
Actions.setAdjustment("raysSpread", 0.2)
assert(Lighting.Brightness == 7 and Lighting.ClockTime == 18 and Lighting.ShadowSoftness == 0.3)
assert(FX.BBC_Atmosfera.Density == 0.9 and FX.BBC_Nuvens.Cover == 0.8)
assert(FX.BBC_Bloom.Intensity == 2 and FX.BBC_Blur.Size == 30)
assert(FX.BBC_CorAjuste.Saturation == -0.5 and FX.BBC_CorAjuste.Contrast == 0.3)
assert(FX.BBC_Profundidade.FocusDistance == 150 and FX.BBC_Profundidade.FarIntensity == 0.7)
assert(FX.BBC_Raios.Intensity == 0.8 and FX.BBC_Raios.Spread == 0.2)
WORLD.sombras = true
Actions.setAdjustment("shadowGearSoftness", 0.8)
Actions.setAdjustment("skyStars", 1250)
Actions.setAdjustment("toneWarmth", 50)
assert(Lighting.ShadowSoftness == 0.8 and FX.BBC_Ceu.StarCount == 1250)
assert(math.abs(FX.BBC_CorTon.TintColor[2] - (1 - 10 / 255)) < 0.00001)
WORLD.master = false
applyLighting()
assert(not FX.BBC_Bloom.Enabled and not FX.BBC_Blur.Enabled)
assert(Lighting.Brightness == nil)
print("lighting settings OK")
