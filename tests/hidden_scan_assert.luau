local grass = obj("grass")
applyGrama(true)
assert(#connections == 1 and #pending == 1)
connections[1].fire(grass); assert(grass.Parent == nil)
applyGrama(false); assert(grass.Parent == Workspace and not connections[1].Connected)
pending[1].visit(grass); assert(grass.Parent == Workspace and not pending[1].active())
applyGrama(true)
local second = obj("grama")
pending[2].visit(second); assert(second.Parent == nil)
Library.Panic = true
local third = obj("grass")
connections[2].fire(third); assert(third.Parent == Workspace)
applyGrama(false); assert(second.Parent == Workspace)
Library.Panic = false
applyMinas(true)
local mine = obj("landmine")
pending[3].visit(mine); assert(mine.Parent == nil)
Actions.alive = false
local stale = obj("landmine")
connections[3].fire(stale); assert(stale.Parent == Workspace)
applyMinas(false); assert(mine.Parent == Workspace)
print("incremental hidden scan cancellation OK")
